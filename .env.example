# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Angel One SmartAPI Credentials (Optional - can also be configured dynamically in Developer Settings)
# NOTE: /api/broker/angelone/auth currently returns a SIMULATED handshake
# (fake JWT/margin values) regardless of these being set -- it does not yet
# call Angel One's real SmartAPI login endpoint. These values are wired
# through so real credentials are ready once that real call is implemented.
ANGELONE_API_KEY=""
ANGELONE_CLIENT_CODE=""
ANGELONE_MPIN=""
ANGELONE_TOTP_SECRET=""

# Razorpay Subscription Gateway (Optional - can also be configured dynamically in Developer Settings)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ADMIN_API_TOKEN: Required to access the Developer Settings panel and its
# API (/api/developer/*, /api/telegram/*, broker auth/connect endpoints).
# These endpoints read and write real broker/payment/Telegram credentials
# and had NO authentication before this was added -- generate a long
# random value (e.g. `openssl rand -hex 32`) and send it as the
# X-Admin-Token header from the Developer Settings UI. Leaving this unset
# disables those endpoints entirely (fails closed, not open).
ADMIN_API_TOKEN=""

# Live signal trial label: every Telegram signal/update starts with a TRIAL banner
# while the strategy builds a real track record. Set to "off" to remove it.
SIGNAL_TRIAL_MODE="on"

# Underlyings that get no new live signals (comma-separated, e.g. "BANKNIFTY").
# Open signals are still tracked. Remove the name and restart to resume.
SIGNAL_PAUSED_SYMBOLS=""
